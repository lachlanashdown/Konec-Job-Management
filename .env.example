# Copy this file to .env and fill in real values before running locally or with docker-compose.

# Password required to log in to the app.
APP_PASSWORD=changeme

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Port the app listens on. Locally this is usually 3000; in Docker (see
# docker-compose.yml) it's 80, matching the container port the production
# reverse proxy (konec-showroom.test-toolkit.app) expects.
PORT=3000

# Set to "true" once the app is served over HTTPS (e.g. behind a reverse proxy).
# docker-compose.yml defaults this to true for the production deployment.
COOKIE_SECURE=false
